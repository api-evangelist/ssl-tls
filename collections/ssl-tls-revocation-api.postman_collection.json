                  "type": "any",
                  "value": "<string>",
                  "key": "certificateId",
                  "description": "(Required) Certificate identifier"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
